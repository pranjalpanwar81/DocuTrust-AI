# Optional. Without these values, DocuTrust returns a retrieval-backed draft,
# so the demo works offline and never fabricates an LLM answer.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
LOG_LEVEL=INFO

# Optional. Required only for image-only PDFs and image uploads.
TESSERACT_CMD=

# JWT Authentication Configuration
# Generate a strong secret key for production: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
# For local development: leave empty (uses SQLite in data/ directory)
# For production (Render): set to your PostgreSQL DATABASE_URL
DATABASE_URL=

